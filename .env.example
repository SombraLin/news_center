NEWS_CENTER_HOST=0.0.0.0
NEWS_CENTER_PORT=8100
NEWS_CENTER_DB_PATH=./data/news.db
NEWS_CENTER_FETCH_TIMEOUT_SECONDS=12
NEWS_CENTER_DEFAULT_TAGS=hot,china,world,tech,finance
NEWS_CENTER_FETCH_INTERVAL_MINUTES=30
NEWS_CENTER_SCHEDULER_AUTOSTART=true
NEWS_CENTER_CLEANUP_DAYS=7
NEWS_CENTER_DEFAULT_PROVIDER=zaker

# Optional admin authentication. Leave empty for local/backward-compatible mode.
# When set, POST /fetch and all /scheduler/* endpoints require X-API-Key.
NEWS_CENTER_ADMIN_API_KEY=

# Article body extraction (best effort)
NEWS_CENTER_CONTENT_FETCH_ENABLED=true
NEWS_CENTER_CONTENT_FETCH_TIMEOUT_SECONDS=8
NEWS_CENTER_CONTENT_FETCH_CONCURRENCY=4
NEWS_CENTER_CONTENT_MAX_CHARS=30000

# Podcast script generation (Qwen-Plus, OpenAI-compatible Chat Completions)
# Use one of DASHSCOPE_API_KEY or NEWS_CENTER_QWEN_API_KEY.
DASHSCOPE_API_KEY=
# NEWS_CENTER_QWEN_API_KEY=
# Shared Beijing endpoint. For production, Alibaba Cloud recommends a workspace-dedicated endpoint.
NEWS_CENTER_QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
NEWS_CENTER_QWEN_TIMEOUT_SECONDS=90
NEWS_CENTER_PODCAST_MAX_ARTICLES=20
NEWS_CENTER_PODCAST_MAX_ARTICLE_CHARS=2500
